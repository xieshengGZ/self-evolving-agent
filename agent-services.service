[Unit]
Description=agent-services AI Agent daemon
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/my_agent/agent-services
EnvironmentFile=/my_agent/agent-services/.env
ExecStart=/my_agent/agent-services/.venv/bin/python -m app.main
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
KillMode=mixed
SyslogIdentifier=agent-services

# 日志：append 到 state/service.log，systemd 不 truncate
StandardOutput=append:/my_agent/agent-services/state/service.log
StandardError=append:/my_agent/agent-services/state/service.log

NoNewPrivileges=false
PrivateTmp=false
ProtectSystem=false
ProtectHome=false

[Install]
WantedBy=multi-user.target
